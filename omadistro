#!/usr/bin/env python3
"""omadistro: change the logo of Omarchy's menu icon (top-left of the bar).

  omadistro setup [shell.json]      what the plugin runs by itself when first enabled: turn the
                                    menu widget on the bar into an OmaDistro copy (same place)
  omadistro set <logo> [shell.json] change the logo, e.g. omadistro set Arch
  omadistro size <60-150> [shell.json]  change the logo size, in percent of Omarchy's icon (100)
  omadistro list                    print every logo name
  omadistro unswap [shell.json]     put Omarchy's own menu widget back, in the same place

The menu's own settings move to shell.json's plugins[] entry for omarchy.menu, where Omarchy
keeps the settings of a widget that is not in the layout (unswap moves them back). Every write
is atomic, follows a symlinked shell.json, is locked against a second omadistro, and is
re-checked just before it lands. The first file it ever changes is kept as
shell.json.omadistro-original, plus the last 3 previous versions as shell.json.omadistro-<time>."""
import fcntl
import glob
import json
import os
import sys
import tempfile
import time

PLUGIN = "blackcode.omadistro"
MENU = "omarchy.menu"
DEFAULT_LOGO = "Omarchy"
SIZE_MIN, SIZE_MAX, SIZE_DEFAULT = 60, 150, 100
DEFAULT = os.path.expanduser("~/.config/omarchy/shell.json")
KEEP_BACKUPS = 3

# Same order as Logos.js (tests/test_omadistro.py keeps the two in step).
LOGOS = [
    "Omarchy", "Arch", "Debian", "Ubuntu", "Fedora", "Linux Mint", "openSUSE", "Manjaro",
    "EndeavourOS", "Gentoo", "Void", "NixOS", "Alpine", "Pop!_OS", "elementary OS", "Zorin OS",
    "Kali", "Rocky Linux", "AlmaLinux", "Red Hat", "CentOS", "Slackware", "CachyOS", "Garuda",
    "Artix", "Asahi", "Nobara", "KDE neon", "Kubuntu", "Xubuntu", "Lubuntu", "Ubuntu MATE",
    "deepin", "Solus", "MX Linux", "Qubes OS", "Tails", "Parrot", "Raspberry Pi", "SUSE",
    "FreeBSD", "OpenBSD", "NetBSD", "Tux",
]


def fail(message):
    print("omadistro: " + message, file=sys.stderr)
    sys.exit(1)


def parse(raw, path):
    try:
        config = json.loads(raw)
    except ValueError as e:
        fail(f"cannot read {path}: {e} (comments in shell.json are not supported); nothing was changed")
    if not isinstance(config, dict):
        fail("shell.json must hold a JSON object; nothing was changed")
    bar = config.get("bar")
    if isinstance(bar, dict) and "layout" in bar:
        layout = bar["layout"]
        if not isinstance(layout, dict):
            fail("bar.layout must be an object; nothing was changed")
        for name, value in layout.items():
            if not isinstance(value, list):
                fail(f"bar.layout.{name} must be a list; nothing was changed")
    if "plugins" in config and not isinstance(config["plugins"], list):
        fail("plugins must be a list; nothing was changed")
    return config


def read_config(path):
    try:
        with open(path, "rb") as f:
            raw = f.read()
    except OSError as e:
        fail(f"cannot read {path}: {e}")
    return raw, parse(raw, path)


def write_atomic(path, data, mode):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".omadistro-", suffix=".tmp")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        if os.path.lexists(tmp):
            os.unlink(tmp)
        raise


def keep_backups(path, raw, mode):
    """The first file ever changed is kept for good; of the rest only the newest few stay."""
    original = path + ".omadistro-original"
    stamped = sorted(glob.glob(path + ".omadistro-2*"))
    if not os.path.exists(original):
        if stamped:
            os.replace(stamped.pop(0), original)  # an older version of this plugin made these
        else:
            write_atomic(original, raw, mode)
    stamp = time.strftime("%Y%m%d-%H%M%S", time.gmtime()) + f"-{time.time_ns() % 1000000:06d}"
    write_atomic(f"{path}.omadistro-{stamp}", raw, mode)
    stamped = sorted(glob.glob(path + ".omadistro-2*"))
    for old in stamped[:-KEEP_BACKUPS]:
        try:
            os.unlink(old)
        except OSError:
            pass


def modify(path, change, attempts=3):
    """Run `change(config)` on shell.json and write the result. `change` returns the new config,
    or None when there is nothing to do. The write is locked against another omadistro and
    re-checked: if the file changed between the read and the write (Omarchy saving, a second
    monitor), the change is redone on the new content. Returns True if the file was written."""
    path = os.path.realpath(path)
    folder = os.environ.get("XDG_RUNTIME_DIR") or os.path.dirname(path)
    with open(os.path.join(folder, "omadistro.lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        for _ in range(attempts):
            raw, config = read_config(path)
            updated = change(config)
            if updated is None:
                return False
            text = (json.dumps(updated, indent=2, ensure_ascii=False) + "\n").encode()
            if text == raw:
                return False
            mode = os.stat(path).st_mode & 0o777
            with open(path, "rb") as f:
                if f.read() != raw:
                    continue  # changed under us: read again
            keep_backups(path, raw, mode)
            write_atomic(path, text, mode)
            return True
    fail("shell.json keeps changing; nothing was changed, try again")


def layout_of(config):
    bar = config.get("bar")
    layout = bar.get("layout") if isinstance(bar, dict) else None
    return layout if isinstance(layout, dict) else {}


def find_entry(config, widget_id):
    """(section, index) of the first layout entry with this id. Entries may be bare strings."""
    for section, entries in layout_of(config).items():
        for i, entry in enumerate(entries):
            if (entry if isinstance(entry, str) else entry.get("id") if isinstance(entry, dict) else None) == widget_id:
                return section, i
    return None


def own_entries(config):
    found = []
    for section, entries in layout_of(config).items():
        for i, entry in enumerate(entries):
            if entry == PLUGIN or (isinstance(entry, dict) and entry.get("id") == PLUGIN):
                found.append((section, i))
    return found


def is_bare(entry):
    return entry == PLUGIN or (isinstance(entry, dict) and entry.get("id") == PLUGIN and not entry.get("logo"))


def check_logo(name):
    if name not in LOGOS:
        fail(f"unknown logo {name!r}; run `omadistro list` for the names")


def swapped(config):
    """The menu entry becomes an OmaDistro copy; the bare entry `omarchy plugin enable` adds is
    dropped when the menu is there, and becomes the copy when the bar has no menu."""
    out = json.loads(json.dumps(config))
    layout = layout_of(out)
    at = find_entry(out, MENU)
    bare = [p for p in own_entries(out) if is_bare(layout[p[0]][p[1]])]
    if at:
        section, i = at
        entry = layout[section][i]
        extra = {k: v for k, v in entry.items() if k != "id"} if isinstance(entry, dict) else {}
        layout[section][i] = {"id": PLUGIN, "logo": DEFAULT_LOGO}
        plugins = out.setdefault("plugins", [])
        existing = next((p for p in plugins if isinstance(p, dict) and p.get("id") == MENU), None)
        if existing is None:
            plugins.append({"id": MENU, **extra})
        else:
            existing.update(extra)
        for section_name, index in sorted(bare, reverse=True):
            if (section_name, index) != (section, i):
                del layout[section_name][index]
    elif bare:
        section, i = bare[0]
        layout[section][i] = {"id": PLUGIN, "logo": DEFAULT_LOGO}
    return out


def setup(path):
    def change(config):
        copies = [layout_of(config)[s][i] for s, i in own_entries(config)]
        if not copies or any(isinstance(c, dict) and c.get("logo") for c in copies):
            return None
        return swapped(config)
    print("set up the menu logo" if modify(path, change) else "already set up")


def with_copies(path, apply):
    """Apply `apply(entry)` to every OmaDistro copy; fail if there is none."""
    def change(config):
        copies = own_entries(config)
        if not copies:
            fail("no OmaDistro copy on the bar; enable the plugin first (omarchy plugin enable blackcode.omadistro)")
        out = json.loads(json.dumps(config))
        layout = layout_of(out)
        for section, i in copies:
            if not isinstance(layout[section][i], dict):
                layout[section][i] = {"id": PLUGIN}
            apply(layout[section][i])
        return out
    return modify(path, change)


def set_logo(path, name):
    check_logo(name)
    changed = with_copies(path, lambda entry: entry.__setitem__("logo", name))
    print("logo: " + name if changed else "logo already " + name)


def set_size(path, value):
    try:
        percent = int(value)
    except ValueError:
        fail(f"size must be a whole number from {SIZE_MIN} to {SIZE_MAX}, not {value!r}")
    if not SIZE_MIN <= percent <= SIZE_MAX:
        fail(f"size must be from {SIZE_MIN} to {SIZE_MAX} percent")

    def apply(entry):
        if percent == SIZE_DEFAULT:
            entry.pop("iconSize", None)
        else:
            entry["iconSize"] = percent
    changed = with_copies(path, apply)
    print(f"size: {percent}%" if changed else f"size already {percent}%")


def unswap(path):
    state = {"found": False}

    def change(config):
        copies = own_entries(config)
        if not copies:
            return None
        state["found"] = True
        out = json.loads(json.dumps(config))
        layout = layout_of(out)
        keep_menu = find_entry(out, MENU) is None
        # The menu's settings went to plugins[] when the logo took its place: move them back.
        plugins = out.get("plugins", [])
        moved = next((p for p in plugins if isinstance(p, dict) and p.get("id") == MENU), None)
        extra = {k: v for k, v in moved.items() if k != "id"} if moved else {}
        for n, (section, i) in enumerate(sorted(copies, reverse=True)):
            if keep_menu and n == len(copies) - 1:
                layout[section][i] = {"id": MENU, **extra}
                if moved is not None:
                    plugins.remove(moved)
                    if not plugins:
                        out.pop("plugins", None)
            else:
                del layout[section][i]
        return out
    modify(path, change)
    print("Omarchy's menu is back" if state["found"] else "nothing to unswap")


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        return
    command = argv[1]
    if command == "list":
        print("\n".join(LOGOS))
    elif command == "setup":
        setup(argv[2] if len(argv) > 2 else DEFAULT)
    elif command == "set":
        if len(argv) < 3:
            fail("usage: omadistro set <logo> [shell.json]")
        set_logo(argv[3] if len(argv) > 3 else DEFAULT, argv[2])
    elif command == "size":
        if len(argv) < 3:
            fail("usage: omadistro size <60-150> [shell.json]")
        set_size(argv[3] if len(argv) > 3 else DEFAULT, argv[2])
    elif command == "unswap":
        unswap(argv[2] if len(argv) > 2 else DEFAULT)
    else:
        fail(f"unknown command {command!r}; try omadistro --help")


if __name__ == "__main__":
    main(sys.argv)
